{
  "name": "HomaCalc canonical hostname redirects",
  "kind": "zone",
  "phase": "http_request_dynamic_redirect",
  "rules": [
    {
      "ref": "homacalc_www_to_apex",
      "description": "Permanently redirect www to the canonical HTTPS apex while preserving path and query string",
      "expression": "(http.host eq \"www.homacalculator.com\")",
      "action": "redirect",
      "action_parameters": {
        "from_value": {
          "status_code": 301,
          "target_url": {
            "expression": "concat(\"https://homacalculator.com\", http.request.uri.path)"
          },
          "preserve_query_string": true
        }
      },
      "enabled": true
    }
  ]
}
